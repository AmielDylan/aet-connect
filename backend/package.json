{
  "name": "aet-connect-backend",
  "version": "0.1.0",
  "description": "Backend API pour AET Connect - Annuaire panafricain des Anciens Enfants de Troupe",
  "main": "dist/app.js",
  "scripts": {
    "dev": "doppler run -- tsx watch src/app.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/app.js",
    "test": "npm run test:unit && npm run test:e2e:schools",
    "test:unit": "tsx tests/assert-local.ts && vitest run",
    "test:watch": "vitest",
    "test:e2e:schools": "tsx tests/assert-local.ts && tsx tests/e2e/schools/schools-complete.test.ts",
    "lint": "eslint src/**/*.ts",
    "db:test": "tsx scripts/test-connection.ts"
  },
  "keywords": [
    "api",
    "backend",
    "aet",
    "alumni",
    "africa"
  ],
  "author": "AET Connect Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "supertest": "^7.3.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  }
}
